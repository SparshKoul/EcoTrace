# Copy to .env.local and adjust.

# Backend core API base URL. All /api/v1/* calls go here.
VITE_API_BASE_URL=http://localhost:8000

# Use built-in sample data instead of a live backend (handy before backend/microservice exist).
VITE_USE_MOCK_API=true

# Map tile template. {z}/{x}/{y} placeholders are required.
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Initial map centre before the citizen shares their live location.
# Defaults to Chitkara University, Rajpura, Punjab.
VITE_PILOT_LAT=30.5157
VITE_PILOT_LNG=76.6592
