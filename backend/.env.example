# Server
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=info

# PostgreSQL / Supabase connection string.
# Supabase -> Project Settings -> Database -> Connection string -> URI (port 5432 direct or 6543 pooler).
# Replace [YOUR-PASSWORD] with the database password. Keep this file out of git.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Supabase requires TLS. Auto-detected from the host; uncomment to override.
# DB_SSL=true

# AI microservice
AI_SERVICE_URL=http://127.0.0.1:8100

# Supabase project (optional until storage/auth is wired up).
# Find these in Supabase -> Project Settings -> API.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[PUBLIC-ANON-KEY]
# Server-only! Bypasses Row Level Security. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=[SERVICE-ROLE-KEY]
SUPABASE_RAW_BUCKET=ecotrace-raw-private
SUPABASE_PUBLIC_BUCKET=ecotrace-sanitized-public
