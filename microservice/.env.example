# EcoTrace AI/ML microservice — environment template.
# Copy to `.env` and fill in values. NEVER commit real secrets.

# --- General ---------------------------------------------------------------
APP_NAME="EcoTrace AI/ML Microservice"
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# --- Internal service auth (Node.js backend must send this header) --------
# X-Internal-Service-Key: <value>. Leave empty to disable (dev only).
INTERNAL_SERVICE_KEY=
# Comma-separated browser origins allowed to call this service (production).
ALLOWED_ORIGINS=

# --- Request limits --------------------------------------------------------
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=40000000
VERIFY_CONCURRENCY_LIMIT=4

# --- YOLO detector ---------------------------------------------------------
YOLO_ENABLED=true
# Pretrained checkpoint downloaded by ultralytics, or a local path in weights/.
YOLO_MODEL_PATH=yolo26n.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
# auto | cpu | cuda | cuda:0
YOLO_DEVICE=auto
YOLO_MAX_DETECTIONS=100

# --- Amazon Rekognition (Phase 2) ------------------------------------------
REKOGNITION_ENABLED=false  # paid AWS API — opt in only if your account has access
# Mumbai region — lowest latency from India; Rekognition & Bedrock available.
AWS_REGION=ap-south-1
AWS_REKOGNITION_MAX_LABELS=30
AWS_REKOGNITION_MIN_CONFIDENCE=55
# Bounded retries/timeouts (botocore) so AWS calls fail inside the request budget.
AWS_MAX_ATTEMPTS=3
AWS_CONNECT_TIMEOUT_SECONDS=3
AWS_READ_TIMEOUT_SECONDS=10
# Standard AWS credential provider chain: .env (dev, git-ignored) -> shell env
#   -> ~/.aws/credentials -> IAM role.
# NEVER put credentials in tracked source files (they would be committed).
# Local dev: put keys in microservice/.env (git-ignored):
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...

# --- Privacy (Phase 2) ---------------------------------------------------------
# Gaussian kernel (odd) used to blur faces and vehicle plates.
PRIVACY_BLUR_KERNEL=51

# --- Azure AI Foundry vision judge -----------------------------------------
AZURE_JUDGE_ENABLED=true
# Resource base URL (the /openai/deployments/... path is built by the service).
AZURE_FOUNDRY_ENDPOINT=https://<resource>.openai.azure.com
AZURE_FOUNDRY_KEY=<your-foundry-key>
AZURE_FOUNDRY_DEPLOYMENT=gpt-5-mini
AZURE_FOUNDRY_API_VERSION=2025-01-01-preview
AZURE_JUDGE_TIMEOUT_SECONDS=45
AZURE_JUDGE_MAX_COMPLETION_TOKENS=1500
# GPT-5 reasoning models: low|medium|high
AZURE_JUDGE_REASONING_EFFORT=low

# --- Amazon Bedrock (kept for compatibility, disabled) ----------------------
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=512
BEDROCK_TEMPERATURE=0.0
BEDROCK_TIMEOUT_SECONDS=15
BEDROCK_MAX_RETRIES=3

# --- SigLIP 2 (Phase 4) ----------------------------------------------------
SIGLIP_ENABLED=true   # local, free, pretrained zero-shot waste classification
SIGLIP_MODEL_ID=google/siglip2-base-patch16-224
SIGLIP_EMBEDDING_DEVICE=auto
SIGLIP_SIMILARITY_THRESHOLD=0.85

# --- Storage (originals stay private; never publish unblurred images) ------
ORIGINAL_IMAGE_DIR=/var/lib/ecotrace/originals
PROCESSED_IMAGE_DIR=/var/lib/ecotrace/processed
