# Free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# Requested model first, then fallbacks if the key/region does not expose it.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRA_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Shared folders with the Fastify backend. Both services run on the same machine.
BACKEND_STORAGE_PRIVATE_DIR=../backend/storage/private
BACKEND_STORAGE_PUBLIC_DIR=../backend/storage/public

MICROSERVICE_HOST=127.0.0.1
# 8100 because the backend currently uses 8000. Change both if you want 8000 for FastAPI.
MICROSERVICE_PORT=8100

# Development only: deterministic response without an API key. NEVER enable in production.
USE_MOCK_AI=false
MAX_IMAGE_SIZE_MB=12
